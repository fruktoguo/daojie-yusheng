# NapCat OneBot HTTP Server 地址，不是 WebUI 地址。
NAPCAT_HTTP_URL=http://127.0.0.1:5700

# 与 OneBot HTTP Server 配置一致。仅限回环地址且服务端未设置 token 时可留空。
NAPCAT_ACCESS_TOKEN=

# 唯一允许采集的 QQ 群号白名单，使用英文逗号分隔。
NAPCAT_GROUP_IDS=100000001,100000002

# 默认采集策略。
NAPCAT_HISTORY_DAYS=1
NAPCAT_HISTORY_LIMIT=500
NAPCAT_COLLECT_MEMBER_LIST=true
NAPCAT_COLLECT_MESSAGE_HISTORY=true

# 网络与限流。
NAPCAT_REQUEST_TIMEOUT_SECONDS=15
NAPCAT_REQUEST_INTERVAL_MS=100

# 相对路径按 Skill 目录解析。
NAPCAT_OUTPUT_DIR=.runtime/collections

# 非本机地址默认禁止。确有需要时改为 true，并必须配置非空 token。
NAPCAT_ALLOW_REMOTE=false
